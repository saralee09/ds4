
@{
    ViewBag.Title = "Index";
}

<div class="row">
    <form id="frm"
        <div class="col-lg-6 col-lg-offsset-3">
            usuario
            <input type=" text="text" name="user" />
            Password
            <input type=" password="password" name="pass" />
            <input type="button" class="btn btn-success" value="entrar"/>
        </div>
    </form>
</div>

@section scripts
{
    <script>
        $(document).ready(function () {
            $("#frm").submit(function (e) {
                e.preventDefault();
                url = "@Url.Content("~/Access/Enter")"
                parametros = $(this).serialize();

                $.post(url, parametros, function (data) {
                    if (data == "1") {
                        document.location.href = "@Url.Content("~/")";
                    }
                    else {
                        alert(data);
                    }
                })
            })
        })
    </script>
}

