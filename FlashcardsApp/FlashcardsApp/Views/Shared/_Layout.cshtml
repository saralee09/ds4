<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - FlashcardsApp</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap (MVC clásico lo trae) -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f4f6f8;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            border-radius: 0;
        }

        .navbar-brand {
            font-weight: bold;
        }

        .container {
            margin-top: 30px;
        }

        h2 {
            margin-bottom: 20px;
        }

        footer {
            margin-top: 50px;
            padding: 15px;
            text-align: center;
            color: #777;
            font-size: 13px;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-inverse">
        <div class="container">
            <div class="navbar-header">
                <a class="navbar-brand" href="/">FlashcardsApp</a>
            </div>

            <ul class="nav navbar-nav">
                <li>@Html.ActionLink("Flashcards", "Index", "Flashcards")</li>
                <li>@Html.ActionLink("Stats", "Index", "Stats")</li>
            </ul>
        </div>
    </nav>

    <!-- CONTENIDO -->
    <div class="container">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer>
        Flashcards App · ASP.NET MVC · Demo académica
    </footer>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
